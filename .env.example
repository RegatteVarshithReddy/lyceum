# Base URL you'll reach this app at. Required for Google Drive/Dropbox OAuth
# redirect URIs to be built correctly.
PUBLIC_URL=http://localhost:4100

# Password gate for the whole app. This app has no per-user accounts, no
# rate limiting, and no HTTPS of its own — it's designed to sit behind a VPN
# (Tailscale, WireGuard) or a reverse proxy that terminates TLS, not to be
# exposed directly to the internet.
APP_PASSWORD=change-me
SESSION_SECRET=change-me-too-a-long-random-string
LYCEUM_COOKIE_SECURE=false

PORT=4100

# Which storage provider your library and notes live on. One of:
# webdav | s3 | googledrive | dropbox
# Fill in the matching block below. See README.md for how to obtain
# credentials for each provider.
STORAGE_PROVIDER=webdav

# --- webdav (Nextcloud, ownCloud, or a plain WebDAV server) ---------------
# WEBDAV_PASSWORD should be an app password generated by your server
# (Nextcloud/ownCloud: Settings -> Security -> Create new app password),
# not your account password.
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
# true for Nextcloud/ownCloud (uses their /remote.php/dav/files/<user>/
# path convention), false for a plain WebDAV server. Leave unset to
# auto-detect based on which vars are set.
WEBDAV_NEXTCLOUD_MODE=

# --- s3 (AWS S3, MinIO, Backblaze B2, or any S3-compatible storage) -------
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=

# --- googledrive -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLEDRIVE_ROOT_FOLDER_ID=

# --- dropbox ----------------------------------------------------------------
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_ROOT_PATH=

# Root folder holding your course folders, e.g. "Lectures" or "Courses".
# Relative to whichever storage provider's root is configured above.
VIDEO_LIBRARY_PATH=Lectures

# Comma-separated names of top-level folders (relative to the library path
# above) that are actually BUNDLES of several courses rather than one course
# each — e.g. a "MySQL Courses" folder containing separate "MySQL Basics",
# "Advanced MySQL" course folders. Listed folders are expanded one level:
# their immediate subfolders become the courses, instead of the bundle
# folder itself.
VIDEO_BUNDLE_FOLDERS=

# Root folder holding your ebook files (PDF/EPUB/AZW3), flat — no per-book
# subfolders expected.
BOOKS_LIBRARY_PATH=Books

# Where notes get pushed as markdown files — an Obsidian vault (or any
# folder you want plain .md files written to) on the same storage provider.
NOTES_VAULT_PATH=Obsidian/My Brain

# Container's local timezone, so activity-log dates line up with your day.
TZ=America/New_York
